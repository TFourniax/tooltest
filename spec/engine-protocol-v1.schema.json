{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:diffwitness:schema:engine-protocol:1",
  "title": "DiffWitness advisory engine protocol v1",
  "description": "Versioned local subprocess contract for advisory proof planning. Engine output may optimize experiment order and grouping but can never mint or override DiffWitness proof claims.",
  "$defs": {
    "gitBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "tree"],
      "properties": {
        "sha": { "type": "string", "minLength": 7, "maxLength": 128 },
        "tree": { "type": "string", "minLength": 7, "maxLength": 128 }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "kind", "additions", "deletions"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "label": { "type": "string", "maxLength": 512 },
        "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
        "additions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "end_line": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "change_id", "repository", "base", "candidate", "mutations", "budget", "policy", "evidence"],
      "properties": {
        "schema_version": { "const": "engine-request-1" },
        "request_id": { "type": "string", "pattern": "^dwerq_[0-9a-f]{24}$" },
        "change_id": { "type": "string", "pattern": "^dwchg_[0-9a-f]{24}$" },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fingerprint"],
          "properties": {
            "fingerprint": { "type": "string", "pattern": "^dwrepo_[0-9a-f]{24}$" }
          }
        },
        "base": { "$ref": "#/$defs/gitBinding" },
        "candidate": { "$ref": "#/$defs/gitBinding" },
        "mutations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/mutation" }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_experiments", "max_total_seconds", "stability_runs"],
          "properties": {
            "max_experiments": { "type": "integer", "minimum": 1 },
            "max_total_seconds": { "type": "number", "exclusiveMinimum": 0 },
            "stability_runs": { "type": "integer", "minimum": 1 }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "strategy"],
          "properties": {
            "mode": { "enum": ["observe", "balanced", "strict"] },
            "strategy": { "enum": ["auto", "adaptive", "exhaustive"] }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command_sha256"],
          "properties": {
            "command_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "changed_test_files": { "type": "array", "items": { "type": "string", "maxLength": 4096 } }
          }
        },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_embedded": { "const": false },
            "local_workspace_read_allowed": { "type": "boolean" }
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "request_digest", "engine", "ordered_mutation_ids", "partitions", "interaction_pairs"],
      "properties": {
        "schema_version": { "const": "engine-plan-1" },
        "request_id": { "type": "string", "pattern": "^dwerq_[0-9a-f]{24}$" },
        "request_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "version": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        "ordered_mutation_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "partitions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }
        },
        "interaction_pairs": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              { "type": "string", "minLength": 1, "maxLength": 256 },
              { "type": "string", "minLength": 1, "maxLength": 256 }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "diagnostics": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "planner_ms": { "type": "number", "minimum": 0 },
            "reason_codes": { "type": "array", "items": { "type": "string", "maxLength": 128 } }
          }
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/plan" }
  ]
}
