{
  "description": "Protect agent actions when opted in, arm DiffWitness proof, inject bounded Project Continuity context, and require evidence before Claude Code stops.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/integrations/plugin_hook.py\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/integrations/plugin_hook.py\" user-prompt-submit",
            "timeout": 8
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/integrations/plugin_hook.py\" protect-pre",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/integrations/plugin_hook.py\" protect-post",
            "timeout": 4
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/integrations/plugin_hook.py\" session-stop",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
