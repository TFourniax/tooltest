{
  "description": "Arm DiffWitness proof, inject bounded Project Continuity context for each task, and require evidence before Codex stops.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/integrations/plugin_hook.py\" session-start --provider codex",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/integrations/plugin_hook.py\" user-prompt-submit --provider codex",
            "timeout": 8,
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/integrations/plugin_hook.py\" session-stop --provider codex",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
