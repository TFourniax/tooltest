{
  "description": "Capture repository state at session start and require DiffWitness proof before Codex stops.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/integrations/plugin_hook.py\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/integrations/plugin_hook.py\" session-stop",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
